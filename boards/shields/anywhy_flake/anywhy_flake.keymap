#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp N1 &kp N2 &kp N3        &kp N4    &kp N5         &kp N6       &kp N7        &kp N8     &kp N9   &kp N0     &kp BSPC
&kp TAB    &kp Q  &kp W  &kp E         &kp R     &kp T          &kp Y        &kp U         &kp I      &kp O    &kp P      &kp MINUS
&kp LCTRL  &kp A  &kp S  &kp D         &kp F     &kp G          &kp H        &kp J         &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V     &kp B          &kp N        &kp M         &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_SHIFT
           &none  &none  &kp LEFT_ALT  &kp LGUI  &lt 1 SPACE    &lt 2 SPACE  &lt 3 RETURN  &kp RGUI   &none    &none
            >;
        };

        lower {
            bindings = <
&trans       &trans        &trans            &trans        &trans           &trans       &trans           &trans        &trans        &trans        &trans         &trans
&kp ESCAPE    &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp BACKSPACE    &kp LG(T)    &kp KP_MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL      &trans
&kp LG(GRAVE) &kp RET       &kp LG(X)         &kp LG(C)     &kp LG(V)        &kp LG(N)    &kp KP_PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RETURN     &trans
&kp GRAVE     &kp LG(Z)     &kp C_VOL_DN      &kp C_MUTE    &kp C_VOLUME_UP  &kp LC(UP)   &kp KP_MULTIPLY  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_DIVIDE  &trans
              &none         &none             &trans        &trans           &trans       &trans           &trans        &kp NUMBER_0  &none         &none
            >;
        };

        raise {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &trans             &trans            &trans             &trans    &trans     &trans         &trans
&trans  &trans   &kp F7  &kp F8  &kp F9  &kp LEFT_BRACE     &kp PG_UP         &kp BACKSPACE      &kp UP    &kp DEL    &kp EQUAL      &kp PIPE
&trans  &kp F10  &kp F4  &kp F5  &kp F6  &kp RIGHT_BRACE    &kp PG_DN         &kp LEFT           &kp DOWN  &kp RIGHT  &kp ENTER      &kp GRAVE
&trans  &trans   &kp F1  &kp F2  &kp F3  &studio_unlock     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PLUS  &trans     &kp BACKSLASH  &kp TILDE
        &none    &none   &trans  &trans  &trans             &trans            &trans             &trans    &none      &none
            >;
        };

        numbers {
            bindings = <
&trans        &trans            &trans            &trans            &trans            &trans              &trans            &trans            &trans            &trans            &trans            &trans
&bt BT_SEL 2  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)    &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)  &kp BACKSPACE
&bt BT_SEL 1  &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5        &kp NUMBER_6      &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9      &kp NUMBER_0      &kp CAPS
&bt BT_SEL 0  &trans            &trans            &trans            &trans            &soft_off           &trans            &trans            &trans            &trans            &trans            &trans
              &none             &none             &bt BT_CLR        &trans            &trans              &trans            &trans            &trans            &none             &none
            >;
        };
    };
};
